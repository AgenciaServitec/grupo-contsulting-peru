</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const btnText = document.getElementById("btn-text") as HTMLSpanElement;
    const btnIcon = document.getElementById("btn-icon") as HTMLElement;
    const successAlert = document.getElementById("success-alert") as HTMLDivElement;
    const closeSuccessBtn = document.getElementById("close-success-btn") as HTMLButtonElement;

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            submitBtn.disabled = true;
            btnText.textContent = "Enviando...";
            btnIcon.classList.add("hidden");

            const formData = new FormData(form);

            const selectedService = formData.get("service");
            const originalMessage = formData.get("message");
            const combinedMessage = `[Área: ${selectedService}] - ${originalMessage}`;

            const entryPayload = {
                category: "contact",
                hostname: "grupocontsulting.com",
                message: combinedMessage,
                client: {
                    fullName: formData.get("name"),
                    email: formData.get("email"),
                    phone: {
                        prefix: "+51",
                        number: formData.get("phone"),
                    },
                    document: {
                        type: "DNI",
                        number: "",
                    },
                },
            };

            try {
                const response = await fetch("https://api-servitec-peru.web.app/entries/contact", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(entryPayload),
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.error || "Error al enviar el mensaje");
                }

                form.reset();
                form.style.opacity = "0";
                setTimeout(() => {
                    successAlert.classList.remove("hidden");
                    successAlert.classList.add("flex");
                }, 300);

            } catch (error: any) {
                console.error("Error detallado:", error);
                alert(error.message || "Hubo un problema al enviar el mensaje. Por favor intente nuevamente.");
            } finally {
                submitBtn.disabled = false;
                btnText.textContent = "Enviar Solicitud";
                btnIcon.classList.remove("hidden");
            }
        });

        if (closeSuccessBtn) {
            closeSuccessBtn.addEventListener("click", () => {
                successAlert.classList.add("hidden");
                successAlert.classList.remove("flex");
                form.style.opacity = "1";
            });
        }
    }
</script>