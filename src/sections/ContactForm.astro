            <div class="w-full lg:w-[65%] bg-gray-50/50 p-8 lg:p-16 rounded-[2.5rem] border border-gray-100 shadow-sm relative">
                <form id="contact-form" class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12 transition-opacity duration-300">
                    <div class="relative group">
                        <label for="name" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Nombre Completo</label>
                        <input type="text" id="name" name="name" required placeholder="Nombre y Apellidos" class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium text-lg" />
                    </div>

                    <div class="relative group">
                        <label for="phone" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Nro. Teléfono</label>
                        <input type="tel" id="phone" name="phone" required placeholder="Teléfono" class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium text-lg" />
                    </div>

                    <div class="relative group">
                        <label for="email" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Correo Corporativo</label>
                        <input type="email" id="email" name="email" required placeholder="ejemplo@empresa.com" class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium text-lg" />
                    </div>

                    <div class="relative group">
                        <label for="service" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Área de Consultoría</label>
                        <select id="service" name="service" required class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep focus:outline-none focus:border-brand-deep transition-all font-medium text-lg appearance-none cursor-pointer">
                            <option value="" disabled selected>Seleccione una especialidad</option>
                            <option value="Servicio Contable">Servicio Contable</option>
                            <option value="Servicio Administrativo">Servicio Administrativo</option>
                            <option value="Servicio Legal">Servicio Legal</option>
                            <option value="Servicio de Marketing">Servicio de Marketing</option>
                            <option value="Servicio Informático">Servicio Informático</option>
                            <option value="Servicio Inmobiliario">Servicio Inmobiliario</option>
                            <option value="Servicio Educacional">Servicio Educacional</option>
                        </select>
                    </div>

                    <div class="relative group md:col-span-2">
                        <label for="message" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Detalles del Requerimiento</label>
                        <textarea id="message" name="message" rows="3" required placeholder="Describa brevemente su consulta..." class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium resize-none text-lg"></textarea>
                    </div>

                    <div class="md:col-span-2 pt-10">
                        <button type="submit" id="submit-btn" class="w-full md:w-auto inline-flex justify-center items-center gap-6 bg-brand-deep text-white px-16 py-6 rounded-sm font-bold tracking-[0.3em] uppercase hover:bg-accent-ocean transition-all group shadow-2xl disabled:opacity-70 disabled:cursor-not-allowed">
                            <span id="btn-text">Enviar Solicitud</span>
                            <svg id="btn-icon" class="w-6 h-6 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
