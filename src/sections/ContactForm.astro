---
---

<section id="contacto" class="py-24 lg:py-44 bg-white border-t border-gray-100 overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-20">

        <div class="mb-20 lg:mb-32">
            <h2 class="text-5xl lg:text-[5rem] font-semibold text-brand-deep leading-[1.05] tracking-tight">
                Inicie su <br/>proyección hoy.
            </h2>
        </div>

        <div class="flex flex-col lg:flex-row gap-24 lg:gap-40">

            <div class="w-full lg:w-[35%] flex flex-col justify-between">
                <div>
                    <p class="text-brand-deep/70 text-xl lg:text-2xl mb-16 font-medium leading-relaxed max-w-sm">
                        Estamos listos para atender los desafíos de su empresa con soluciones personalizadas en todo el país.
                    </p>

                    <div class="space-y-12">
                        <div class="flex flex-col gap-3 group">
                            <span class="text-[10px] font-extrabold text-brand-deep/30 uppercase tracking-[0.3em]">Atención Directa</span>
                            <div class="flex flex-col gap-1">
                                <a href="tel:949730886" class="text-2xl font-bold text-brand-deep hover:text-accent-ocean transition-colors">949 730 886</a>
                                <a href="tel:012524915" class="text-xl font-semibold text-brand-deep/60 hover:text-accent-ocean transition-colors">01 252 491</a>
                            </div>
                        </div>

                        <div class="flex flex-col gap-3">
                            <span class="text-[10px] font-extrabold text-brand-deep/30 uppercase tracking-[0.3em]">Sede Principal</span>
                            <address class="text-lg lg:text-xl font-medium text-brand-deep not-italic leading-snug">
                                Av. Ariosto Matellini N° 677,<br/>
                                Ofici. 301, Chorrillos, Lima.
                            </address>
                        </div>

                        <div class="flex flex-col gap-3">
                            <span class="text-[10px] font-extrabold text-brand-deep/30 uppercase tracking-[0.3em]">Email Corporativo</span>
                            <a href="mailto:grupocontsultingperu@gmail.com" class="text-lg font-bold text-brand-deep border-b border-brand-deep/10 w-fit pb-1 hover:border-accent-ocean hover:text-accent-ocean transition-all italic">
                                grupocontsultingperu@gmail.com
                            </a>
                        </div>
                    </div>
                </div>

                <div class="hidden lg:block pt-20">
                    <div class="w-20 h-[1px] bg-brand-deep/20"></div>
                </div>
            </div>

            <div class="w-full lg:w-[65%] bg-gray-50/50 p-8 lg:p-16 rounded-[2.5rem] border border-gray-100 shadow-sm">
                <form class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">

                    <div class="relative group">
                        <label for="name" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Nombre Completo</label>
                        <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Nombre y Apellidos"
                                class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium text-lg"
                        />
                    </div>

                    <div class="relative group">
                        <label for="phone" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Nro. Telefono</label>
                        <input
                                type="tel"
                                id="phone"
                                name="phone"
                                placeholder="Telefono"
                                class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium text-lg"
                        />
                    </div>

                    <div class="relative group">
                        <label for="email" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Correo Corporativo</label>
                        <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="ejemplo@empresa.com"
                                class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium text-lg"
                        />
                    </div>

                    <div class="relative group">
                        <label for="service" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Área de Consultoría</label>
                        <select
                                id="service"
                                name="service"
                                class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep focus:outline-none focus:border-brand-deep transition-all font-medium text-lg appearance-none cursor-pointer"
                        >
                            <option value="" disabled selected>Seleccione una especialidad</option>
                            <option value="contable">Servicio Contable</option>
                            <option value="administrativo">Servicio Administrativo</option>
                            <option value="legal">Servicio Legal</option>
                            <option value="marketing">Servicio de Marketing</option>
                            <option value="informatico">Servicio Informático</option>
                            <option value="inmobiliario">Servicio Inmobiliario</option>
                        </select>
                    </div>

                    <div class="relative group md:col-span-2">
                        <label for="message" class="block text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3 transition-colors group-focus-within:text-accent-ocean">Detalles del Requerimiento</label>
                        <textarea
                                id="message"
                                name="message"
                                rows="3"
                                placeholder="Describa brevemente su consulta..."
                                class="w-full bg-transparent border-b border-gray-200 py-3 text-brand-deep placeholder:text-gray-300 focus:outline-none focus:border-brand-deep transition-all font-medium resize-none text-lg"
                        ></textarea>
                    </div>

                    <div class="md:col-span-2 pt-10">
                        <button class="w-full md:w-auto inline-flex justify-center items-center gap-6 bg-brand-deep text-white px-16 py-6 rounded-sm font-bold tracking-[0.3em] uppercase hover:bg-accent-ocean transition-all group shadow-2xl">
                            Enviar Solicitud
                            <svg class="w-6 h-6 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</section>