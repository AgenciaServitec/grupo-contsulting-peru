---
---

<section id="ubicacion" class="py-24 lg:py-40 bg-gray-50 overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
        <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-center">

            <div class="w-full lg:w-1/3 order-2 lg:order-1">
                <h2 class="text-4xl lg:text-5xl font-semibold text-brand-deep leading-[1.1] mb-8 tracking-tight">
                    Nuestra sede <br/> en <span class="text-accent-ocean">Lima</span>.
                </h2>

                <div class="space-y-10">
                    <p class="text-brand-deep/70 text-lg font-medium leading-relaxed">
                        Ubicados estratégicamente en Chorrillos para coordinar operaciones a nivel nacional. Brindamos atención presencial y consultoría remota con el más alto estándar profesional.
                    </p>

                    <div class="flex flex-col gap-6">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-brand-deep flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div>
                                <span class="text-[10px] font-extrabold text-brand-deep/40 uppercase tracking-widest block mb-1">Dirección</span>
                                <address class="text-lg font-bold text-brand-deep not-italic leading-snug">
                                    Av. Ariosto Matellini N° 677,<br/>
                                    Ofici. 301, Chorrillos 15064.
                                </address>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-accent-cyan flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-brand-deep" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div>
                                <span class="text-[10px] font-extrabold text-brand-deep/40 uppercase tracking-widest block mb-1">Horario de Atención</span>
                                <p class="text-lg font-bold text-brand-deep">
                                    Lunes a Sábado <br/>
                                    <span class="text-brand-deep/60">09:00 AM - 10:00 PM </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="pt-8">
                        <a
                                href="https://www.google.com/maps/dir//ESTUDIO+CONTABLE+EMPRESARIAL+SANCHEZ+%26+ASOCIADOS,+Av.+Ariosto+Matellini+677,+Chorrillos+15064"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-3 text-xs font-extrabold tracking-[0.2em] text-brand-deep uppercase group"
                        >
                            Ver en Google Maps
                            <svg class="w-5 h-5 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="w-full lg:w-2/3 order-1 lg:order-2 relative">
                <div class="absolute -inset-4 border border-brand-deep/5 rounded-[2.5rem] pointer-events-none hidden lg:block"></div>

                <div class="relative w-full aspect-video lg:aspect-square lg:max-h-[600px] rounded-[2rem] overflow-hidden shadow-2xl border-8 border-white group">
                    <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3900.2223405391054!2d-77.0229342240212!3d-12.181829688056223!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105b9b1d3032d9b%3A0x86134b29381c6204!2sAv.%20Ariosto%20Matellini%20677%2C%20Chorrillos%2015064!5e0!3m2!1ses-419!2spe!4v1713388000000!5m2!1ses-419!2spe"
                            class="w-full h-full grayscale-[0.2] group-hover:grayscale-0 transition-all duration-700"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>

                    <div class="absolute top-6 right-6 bg-brand-deep text-white p-4 rounded-2xl shadow-xl border border-white/10 flex items-center gap-3 pointer-events-none">
                        <div class="w-2 h-2 rounded-full bg-accent-cyan animate-pulse"></div>
                        <span class="text-[10px] font-bold tracking-widest uppercase">Oficina 301</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>