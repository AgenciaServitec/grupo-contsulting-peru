---
interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;

const watermarkText = title.replace("Servicio ", "").replace("de ", "");
---

<section class="relative w-full min-h-[75vh] lg:min-h-[80vh] flex flex-col justify-center overflow-hidden bg-white border-b border-gray-100 pt-28 pb-16 lg:pt-32 lg:pb-20">

    <div class="absolute inset-0 bg-gradient-to-br from-background-soft via-white to-gray-50/50 z-0"></div>

    <div class="absolute inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-[radial-gradient(#00303e_1px,transparent_1px)] [background-size:24px_24px] lg:[background-size:32px_32px] opacity-[0.04]"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-white via-white/70 to-transparent"></div>
    </div>

    <div class="absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 w-full flex justify-center z-0 pointer-events-none select-none opacity-[0.02]">
        <h2 class="text-[8rem] sm:text-[12rem] md:text-[16rem] lg:text-[20rem] xl:text-[26rem] font-bold tracking-tighter text-brand-deep whitespace-nowrap">
            {watermarkText}
        </h2>
    </div>

    <div class="max-w-[1440px] mx-auto px-6 lg:px-20 w-full relative z-10 flex flex-col h-full">

        <div class="w-full mb-10 lg:mb-16">
            <a href="/#servicios" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/80 backdrop-blur-sm rounded-full border border-gray-200 text-[10px] font-extrabold tracking-widest uppercase text-brand-deep hover:border-accent-cyan hover:text-accent-cyan transition-all shadow-sm group w-fit">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                Todos los servicios
            </a>
        </div>

        <div class="w-full flex flex-col items-start text-left">

            <div class="flex items-center gap-4 mb-6">
                <div class="w-10 h-[2px] bg-accent-cyan"></div>
                <span class="text-[10px] font-extrabold tracking-[0.3em] uppercase text-brand-deep/50">Consultoría Especializada</span>
            </div>

            <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[5.5rem] xl:text-[6rem] font-semibold text-brand-deep leading-[1.05] mb-6 lg:mb-8 tracking-tight">
                {title}
            </h1>

            <p class="text-brand-deep/70 text-lg sm:text-xl lg:text-[1.35rem] leading-relaxed font-medium mb-10 lg:mb-14 max-w-full lg:max-w-[80%] xl:max-w-[70%] text-pretty">
                {description}
            </p>

            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 lg:gap-10">
                <a href="/#contacto" class="inline-flex items-center justify-center gap-4 bg-brand-deep text-white px-8 py-4 sm:px-10 sm:py-5 text-xs font-bold tracking-[0.2em] uppercase hover:bg-accent-cyan transition-all group shadow-xl w-full sm:w-auto text-center">
                    Solicitar Asesoría
                    <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>

                <div class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] font-bold tracking-widest uppercase text-brand-deep/40">
                    Deslice para ver
                    <svg class="w-4 h-4 animate-bounce text-accent-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </div>
            </div>

        </div>

    </div>
</section>