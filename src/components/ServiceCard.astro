---
interface Props {
    title: string;
    description: string;
    icon: string;
    href: string;
}

const { title, description, icon, href } = Astro.props;
---

<div class="group relative bg-white p-8 rounded-xl shadow-sm border border-gray-100 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:border-accent-cyan/30 overflow-hidden">

    <div class="absolute -right-8 -top-8 w-24 h-24 bg-brand-muted/20 rounded-full transition-transform group-hover:scale-150"></div>

    <div class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-gradient-to-br from-accent-blue to-accent-cyan text-brand-muted mb-6 shadow-lg shadow-accent-cyan/20">
        <slot name="icon" />
    </div>

    <h3 class="text-xl font-bold text-brand-deep mb-3 group-hover:text-accent-blue transition-colors">
        {title}
    </h3>

    <p class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3">
        {description}
    </p>

    <a href={href} class="inline-flex items-center text-sm font-bold text-accent-ocean hover:text-accent-cyan transition-colors group/link">
        Saber más
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
    </a>
</div>