---
import ContentWidth from "./ContentWidth.astro";

const currentYear = new Date().getFullYear();

const footerLinks = {
    empresa: [
        { name: "Sobre Nosotros", href: "#nosotros" },
        { name: "Nuestra Misión", href: "#mision" },
        { name: "Sedes", href: "#sedes" },
        { name: "Trabaja con nosotros", href: "#" }
    ],
    servicios: [
        { name: "Asesoría Contable", href: "#" },
        { name: "Consultoría Legal", href: "#" },
        { name: "Marketing Digital", href: "#" },
        { name: "Soporte Informático", href: "#" },
        { name: "Gestión Inmobiliaria", href: "#" }
    ],
    contacto: {
        direccion: "Av. Ariosto Matellini N° 677, Chorrillos",
        telefono: "949 730 886",
        horario: "Lun - Vie: 9:00 AM - 6:00 PM"
    }
};
---

<footer class="bg-primary-dark text-white pt-20 pb-10" id="footer">
    <ContentWidth>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">

            <div class="space-y-6">
                <div class="flex items-center gap-3">
                    <span class="text-xl">
                        CONTSULTING<span class="text-secondary">PERÚ</span>
                    </span>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed max-w-xs">
                    Soluciones integrales para el crecimiento de tu empresa bajo modalidad outsourcing e in-house con más de 10 años de experiencia.
                </p>
                <div class="flex gap-4">
                    <a href="#" class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center hover:bg-secondary hover:text-primary-dark transition-all">
                        <span class="sr-only">Facebook</span>
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                    </a>
                    <a href="#" class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center hover:bg-secondary hover:text-primary-dark transition-all">
                        <span class="sr-only">LinkedIn</span>
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    </a>
                </div>
            </div>

            <div>
                <h4 class="text-white text-xs mb-6">Compañía</h4>
                <ul class="space-y-4">
                    {footerLinks.empresa.map(link => (
                            <li><a href={link.href} class="text-white hover:text-secondary text-sm transition-colors">{link.name}</a></li>
                    ))}
                </ul>
            </div>

            <div>
                <h4 class="text-white text-xs mb-6">Especialidades</h4>
                <ul class="space-y-4">
                    {footerLinks.servicios.map(service => (
                            <li><a href={service.href} class="text-white hover:text-secondary text-sm transition-colors">{service.name}</a></li>
                    ))}
                </ul>
            </div>

            <div>
                <h4 class="text-white text-xs mb-6">Sede Central</h4>
                <div class="space-y-5">
                    <div class="flex gap-3 items-start">
                        <svg class="w-5 h-5 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        <p class="text-gray-400 text-sm leading-snug">{footerLinks.contacto.direccion}, Lima 15064</p>
                    </div>
                    <div class="flex gap-3 items-center">
                        <svg class="w-5 h-5 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <p class="text-gray-400 text-sm">{footerLinks.contacto.telefono}</p>
                    </div>
                    <div class="flex gap-3 items-center">
                        <svg class="w-5 h-5 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <p class="text-gray-400 text-sm">{footerLinks.contacto.horario}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-[11px] font-medium text-gray-500">
            <p>&copy; {currentYear} Grupo Contsulting Perú. Todos los derechos reservados.</p>
            <div class="flex gap-8">
                <a href="#" class="hover:text-secondary transition-colors">Privacidad</a>
                <a href="#" class="hover:text-secondary transition-colors">Términos</a>
                <a href="#" class="hover:text-secondary transition-colors">Sitemap</a>
            </div>
        </div>
    </ContentWidth>
</footer>