---
import miLogo from '../assets/logo.png';
import { Image } from 'astro:assets';

const currentYear = new Date().getFullYear();

const navLinks = [
    { name: "NOSOTROS", href: "#nosotros" },
    { name: "SERVICIOS", href: "#servicios" },
    { name: "UBICACIÓN", href: "#ubicacion" },
    { name: "CONTÁCTENOS", href: "#contacto" },
];
---

<footer class="bg-brand-deep py-16 lg:py-20 relative" id="footer">
    <div class="max-w-7xl mx-auto px-6 flex flex-col justify-between min-h-[250px]">

        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-10 mb-16 lg:mb-24">

            <a href="/" class="flex items-center group">
                <div class="w-12 h-12 flex items-center justify-center  backdrop-blur-sm transition-all">
                    <Image
                            src={miLogo}
                            alt="Logo Grupo Contsulting Perú"
                            class="w-full h-full object-contain"
                    />
                </div>
                <div class="flex flex-col ml-3">
                    <span class="text-white leading-none text-3xl font-sans font-semibold tracking-wide">
                        Contsulting<span class="font-light font-semibold text-white/70">Perú</span>
                    </span>
                </div>
            </a>

            <nav class="flex flex-wrap items-center gap-x-12 gap-y-6">
                {navLinks.map(link => (
                        <a href={link.href} class="text-[15px] font-semibold tracking-wide text-white hover:text-accent-cyan transition-colors">
                            {link.name}
                        </a>
                ))}
            </nav>
        </div>

        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-10 relative">

            <div class="flex flex-col gap-2 text-[13px] text-gray-400">
                <!--<a href="/privacidad" class="hover:text-white transition-colors w-fit">Políticas de Privacidad</a>-->
                <p>Diseñado por Servitec</p> <p>&copy; {currentYear} Grupo Contsulting Perú</p> </div>

