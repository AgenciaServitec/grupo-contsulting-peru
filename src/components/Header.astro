---
import miLogo from '../assets/logo.png';
import { Image } from 'astro:assets';

const navLinks = [
    { name: "NOSOTROS", href: "/#nosotros" },
    { name: "SERVICIOS", href: "#servicios", isDropdown: true },
    { name: "UBICACIÓN", href: "/#ubicacion" },
    { name: "CONTÁCTENOS", href: "/#contacto" },
];

const services = [
    "Contable", "Administrativo", "Legal", "Marketing", "Informatico", "Inmobiliario"
];
---

<header
        id="site-header"
        class="fixed top-0 left-0 w-full z-50 bg-white border-b border-gray-100 transition-all duration-300"
>
    <div id="header-container" class="max-w-7xl mx-auto px-6 py-2 flex items-center justify-between transition-all duration-300">

        <div class="flex items-center gap-8 lg:gap-12">
            <a href="/" class="flex items-center group">
                <div class="w-10 h-10 flex items-center justify-center">
                    <Image
                            src={miLogo}
                            alt="Logo Grupo Contsulting Perú"
                            class="w-full h-full object-contain"
                    />
                </div>
                <div class="flex flex-col ml-2">
                    <span class="text-brand-deep leading-none text-2xl font-sans font-semibold tracking-wide">
                        Contsulting<span class="font-light font-semibold text-brand-deep/70">Perú</span>
                    </span>
                </div>
            </a>
        </div>

        <nav class="hidden lg:flex items-center gap-20">
            {navLinks.map(link => (
                link.isDropdown ? (
                        <div class="relative group cursor-pointer py-4">
                            <div class="flex items-center gap-1 text-[15px] font-semibold tracking-wide text-brand-deep group-hover:text-accent-cyan transition-colors">
                                {link.name}
                                <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                                </svg>
                            </div>

                            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 ease-out translate-y-2 group-hover:translate-y-0 z-50">
                                <div class="w-64 bg-white rounded-xl shadow-[0_20px_40px_-15px_rgba(0,48,62,0.15)] border border-gray-100 overflow-hidden relative">
                                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-deep via-accent-cyan to-brand-muted"></div>

                                    <div class="p-2 flex flex-col gap-1 mt-1">
                                        {services.map(service => (
                                                <a href={`/servicios/${service.toLowerCase()}`} class="group/item flex items-center justify-between px-4 py-3 rounded-lg hover:bg-background-soft/30 transition-all duration-200">
                                                    <span class="text-[14px] font-semibold text-gray-600 group-hover/item:text-accent-blue transition-colors">
                                                        {service}
                                                    </span>
                                                    <svg class="w-4 h-4 text-accent-cyan opacity-0 -translate-x-2 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                                    </svg>
                                                </a>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                ) : (
                        <a href={link.href} class="text-[15px] font-semibold tracking-wide text-brand-deep hover:text-accent-cyan transition-colors">
                            {link.name}
                        </a>
                )
            ))}
        </nav>

        <button
                id="mobile-menu-btn"
                class="lg:hidden p-2 text-brand-deep hover:text-accent-cyan transition-colors"
                aria-label="Menú"
        >
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </div>
</header>

<div
        id="mobile-menu"
        class="fixed inset-0 z-40 bg-white translate-x-full transition-transform duration-500 ease-in-out lg:hidden flex flex-col"
>
    <div class="flex-1 overflow-y-auto px-8 pt-28 pb-8 flex flex-col">

        <nav class="flex flex-col">
            {navLinks.map(link => (
                link.isDropdown ? (
                        <div class="flex flex-col py-5 border-b border-gray-100">
                            <span class="text-[15px] font-bold tracking-wide text-brand-deep">{link.name}</span>
                            <div class="flex flex-col gap-1 mt-4 pl-4 border-l-2 border-brand-muted/50">
                                {services.map(service => (
                                        <a href={`/servicios/${service.toLowerCase()}`} class="flex items-center gap-3 text-[14.5px] font-medium text-gray-600 hover:text-accent-cyan mobile-link py-2.5 transition-colors">
                                            <svg class="w-3.5 h-3.5 text-accent-cyan/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                            </svg>
                                            {service}
                                        </a>
                                ))}
                            </div>
                        </div>
                ) : (
                        <a href={link.href} class="flex items-center justify-between py-5 border-b border-gray-100 text-[15px] font-bold tracking-wide text-brand-deep hover:text-accent-cyan transition-colors mobile-link">
                            {link.name}
                            <svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                )
            ))}
        </nav>

        <div class="mt-auto pt-10">
            <div class="bg-background-soft/30 rounded-xl p-5 border border-brand-muted/20">
                <p class="text-[11px] font-bold text-brand-deep uppercase tracking-widest mb-3">Contacto Directo</p>
                <div class="flex flex-col gap-3">
                    <a href="tel:949730886" class="flex items-center gap-3 text-[13px] font-semibold text-gray-600">
                        <svg class="w-4 h-4 text-accent-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        949 730 886 / 01 252 4915
                    </a>
                    <a href="mailto:grupocontsultingperu@gmail.com" class="flex items-center gap-3 text-[13px] font-semibold text-gray-600 break-all">
                        <svg class="w-4 h-4 text-accent-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        grupocontsultingperu@gmail.com
                    </a>
                    <div class="flex items-start gap-3 text-[13px] font-semibold text-gray-600 mt-1">
                        <svg class="w-4 h-4 text-accent-cyan shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        <span>Av. Ariosto Matellini N° 677<br/>Chorrillos, Lima</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    header {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>

<script>
    const header = document.getElementById('site-header');
    const container = document.getElementById('header-container');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const menuIcon = document.getElementById('menu-icon');
    let lastScroll = 0;

    window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY;

        if (currentScroll > 50) {
            container.classList.add('py-2');
            container.classList.remove('py-4');
            header.classList.add('shadow-sm');
        } else {
            container.classList.add('py-4');
            container.classList.remove('py-2');
            header.classList.remove('shadow-sm');
        }

        if (currentScroll > lastScroll && currentScroll > 200) {
            header.classList.add('-translate-y-full');
        } else {
            header.classList.remove('-translate-y-full');
        }
        lastScroll = currentScroll;
    });

    let isMenuOpen = false;
    function toggleMenu() {
        isMenuOpen = !isMenuOpen;
        mobileMenu.classList.toggle('translate-x-full');
        document.body.classList.toggle('overflow-hidden');
        menuIcon.setAttribute('d', isMenuOpen ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
    }

    mobileMenuBtn.addEventListener('click', toggleMenu);

    document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', () => {
            if(isMenuOpen) toggleMenu();
        });
    });
</script>